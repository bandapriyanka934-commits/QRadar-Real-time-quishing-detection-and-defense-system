# QRadar Backend Configuration Example
# Copy to .env and configure as needed

ENVIRONMENT=development
DEBUG=True

# SQLite Database
DATABASE_URL=sqlite+aiosqlite:///./qradar.db
SYNC_DATABASE_URL=sqlite:///./qradar.db

# Machine Learning Paths (relative to backend or project root)
ML_MODEL_PATH=ml/models/phishing_rf_model.joblib
ML_METADATA_PATH=ml/models/model_metadata.json

# Threat Intelligence: "mock" (default for offline/demo), "google", "virustotal"
THREAT_INTEL_PROVIDER=mock
GSB_API_KEY=
VIRUSTOTAL_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=3.0

# CORS
CORS_ORIGINS=["*"]
