# ==============================================================================
# QRadar — Online Production & Development Environment Configuration
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

# Environment: "development" or "production"
ENVIRONMENT=production
DEBUG=False

# SQLite Database (Async and Sync URLs)
DATABASE_URL=sqlite+aiosqlite:///./qradar.db
SYNC_DATABASE_URL=sqlite:///./qradar.db

# CORS Configuration
# Comma-separated list or JSON array of allowed frontend origins (DO NOT use '*' in production)
# Example for separated domains:
# CORS_ORIGINS=https://qradar.yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Machine Learning Artifact Paths (Relative or Absolute)
ML_MODEL_PATH=ml/models/phishing_rf_model.joblib
ML_METADATA_PATH=ml/models/model_metadata.json

# Threat Intelligence Feed Configuration
# Options: "virustotal", "google", or "mock" (offline test database)
THREAT_INTEL_PROVIDER=virustotal
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
GSB_API_KEY=your_google_safe_browsing_api_key_here
THREAT_INTEL_TIMEOUT_SECONDS=3.0
THREAT_INTEL_CACHE_TTL_HOURS=24

# SSRF Protection & Shortener Resolution Guard
RESOLVE_SHORTENERS=False
SHORTENER_TIMEOUT_SECONDS=3.0
SHORTENER_MAX_HOPS=3

# Rate Limiting Guard
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Data Retention Policy (Days to keep historical scans)
RETENTION_DAYS=30
STRIP_SENSITIVE_QUERY_PARAMS=True
